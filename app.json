{
  "expo": {
    "name": "MoneyKing",
    "slug": "MoneyKing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/NewLogo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/NewLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneyking.financial",
      "googleServicesFile": "./GoogleService-Info.plist" 
    },
    "android": {
      "package": "com.moneyking.financial",
      "googleServicesFile": "./google-services.json", 
      "adaptiveIcon": {
        "foregroundImage": "./assets/NewLogo.png",
        "backgroundColor": "#0D0D0D"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "e9c99268-488c-4451-a9c9-339fa5b0015d"
      }
    }
  }
}